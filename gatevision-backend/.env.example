APP_NAME=GateVision API
VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=gatevision

JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

LOG_DIR=logs
LOG_LEVEL=INFO

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

CORS_ORIGINS=["*"]

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

YOLO_MODEL_PATH=models/yolov8n.pt
PLATE_DETECTION_CONFIDENCE=0.25
DEVICE=cpu

OCR_LANGUAGES=en
OCR_GPU=auto
OCR_MIN_CONFIDENCE=0.45

FACE_SIMILARITY_THRESHOLD=0.65
FACE_MODEL_NAME=buffalo_l
FACE_DEVICE=auto

VEHICLE_SIMILARITY_THRESHOLD=0.75
VEHICLE_MODEL_NAME=resnet50
VEHICLE_DEVICE=auto

WEIGHT_PLATE=0.20
WEIGHT_OCR=0.30
WEIGHT_FACE=0.25
WEIGHT_VEHICLE=0.25

DEFAULT_DRIVER_STATUS=active
DEFAULT_VEHICLE_STATUS=active
ALLOW_MULTIPLE_DRIVERS_PER_VEHICLE=true

DEFAULT_GATE_NAME=Main Gate
ALLOW_REENTRY_WITHOUT_EXIT=false
